!
router bgp {{ asn }}
 neighbor 172.16.{{ id }}.200 remote-as {{ asn }} 
 neighbor 172.16.{{ id }}.200 update-source Loopback0
 neighbor 2001:db8::{{ id }}:200 remote-as {{ asn }} 
 neighbor 2001:db8::{{ id }}:200 update-source Loopback0
 address-family ipv4 unicast 
  neighbor 172.16.{{ id }}.200 activate
 address-family ipv6 unicast
  neighbor 2001:db8::{{ id }}:200 activate
!
